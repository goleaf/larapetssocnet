APP_NAME="PetSocial"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://larapetssocnet.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/larapetssocnet/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=obojus.serveriai.lt
MAIL_PORT=465
MAIL_USERNAME=robot@prus.dev
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=robot@prus.dev
MAIL_FROM_NAME="${APP_NAME}"
MAIL_MARKDOWN_THEME=default
MAIL_MARKDOWN_EXTENSIONS=

QUEUE_MONITOR_QUEUES=
QUEUE_MONITOR_MAX=100
QUEUE_MONITOR_ALERT_EMAIL=

VITE_APP_NAME="${APP_NAME}"
